APP_NAME=SwiftKudi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

# IMPORTANT: For production deployment, change these settings:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-production-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=swiftkudi
DB_USERNAME=swiftkudi
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
INACTIVITY_TIMEOUT=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notifications@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google OAuth
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Optional Google Custom Search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Browser Web Push (VAPID)
VAPID_SUBJECT="mailto:notifications@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Payment Gateway Settings for Local Development
# Enable mock payment mode for local development (simulates successful payments)
PAYMENT_MOCK_ENABLED=false

# Custom callback URL for local development (use ngrok URL for testing with real gateways)
# Example: https://your-ngrok-url.ngrok-free.app
PAYMENT_CALLBACK_URL=

# Auto-enable sandbox mode on local environment
PAYMENT_SANDBOX_AUTO=false

# Payment Gateway Credentials (can be overridden in admin settings)
# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_SANDBOX=false

# Kora
KORA_PUBLIC_KEY=
KORA_SECRET_KEY=
KORA_SANDBOX=false

# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SANDBOX=false

# Production session hardening
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
